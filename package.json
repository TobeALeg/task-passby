{
  "name": "workpet",
  "version": "0.1.0",
  "private": true,
  "description": "把 Codex 中的工作记录为独立 WorkInstance，并交给 WorkBuddy 继续。",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node scripts/copy-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test test/**/*.test.ts",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "setup:integrations": "npm run build && node scripts/install-integrations.mjs",
    "qa:roundtrip": "npm run build && node scripts/qa-roundtrip.mjs",
    "qa:desktop-roundtrip:list": "node scripts/qa-desktop-roundtrip.mjs --list",
    "qa:desktop-roundtrip": "node scripts/qa-desktop-roundtrip.mjs",
    "qa:package": "WORKPET_EXECUTABLE_PATH=$PWD/release/WorkPet-darwin-arm64/WorkPet.app/Contents/MacOS/WorkPet node scripts/qa-electron.mjs",
    "package:mac": "npm run build && electron-packager . WorkPet --platform=darwin --arch=arm64 --app-bundle-id=dev.workpet.desktop --out=release --overwrite --ignore='^/research($|/)' --ignore='^/test($|/)' --ignore='^/output($|/)' --ignore='^/release($|/)'"
  },
  "devDependencies": {
    "@electron/packager": "19.0.1",
    "@types/node": "24.10.0",
    "electron": "44.1.1",
    "playwright": "^1.55.0",
    "typescript": "5.9.3"
  }
}
