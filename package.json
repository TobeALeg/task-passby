{
  "name": "workpet",
  "productName": "Worket",
  "version": "0.1.0",
  "private": true,
  "description": "把 Codex 中的工作记录为独立 WorkInstance，并交给 WorkBuddy 继续。",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node scripts/copy-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test test/**/*.test.ts",
    "start": "npm run package:mac && ./release/Worket-darwin-arm64/Worket.app/Contents/MacOS/Worket",
    "dev": "npm run package:mac && ./release/Worket-darwin-arm64/Worket.app/Contents/MacOS/Worket --dev",
    "setup:integrations": "npm run build && node scripts/install-integrations.mjs",
    "qa:roundtrip": "npm run build && node scripts/qa-roundtrip.mjs",
    "qa:current-context": "npm run build && node scripts/qa-current-context.mjs",
    "qa:workbuddy-context": "npm run build && node scripts/qa-workbuddy-context.mjs",
    "qa:desktop-roundtrip:list": "node scripts/qa-desktop-roundtrip.mjs --list",
    "qa:desktop-roundtrip": "node scripts/qa-desktop-roundtrip.mjs",
    "qa:package": "WORKPET_EXECUTABLE_PATH=$PWD/release/Worket-darwin-arm64/Worket.app/Contents/MacOS/Worket node scripts/qa-electron.mjs",
    "package:mac": "npm run build && electron-packager . Worket --platform=darwin --arch=arm64 --app-bundle-id=dev.workpet.desktop --icon=assets/WorkPet.icns --extra-resource=assets/WorkPet.png --asar.unpackDir=integrations --out=release --overwrite --ignore='^/research($|/)' --ignore='^/test($|/)' --ignore='^/output($|/)' --ignore='^/release($|/)'"
  },
  "devDependencies": {
    "@electron/packager": "19.0.1",
    "@types/node": "24.10.0",
    "electron": "44.1.1",
    "playwright": "^1.55.0",
    "typescript": "5.9.3"
  }
}
